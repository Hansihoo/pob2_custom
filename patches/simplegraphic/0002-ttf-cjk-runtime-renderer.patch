+
+bool r_font_c::CanRenderCodepoint(char32_t cp) const
+{
+	if (cp == U'\n' || cp == U'\t') {
+		return true;
+	}
+	if (numFontHeight > 0 && cp < (unsigned)fontHeights[0]->numGlyph) {
+		return true;
+	}
+	return runtimeFont && runtimeFont->HasGlyph(cp);
+}
+
+bool r_font_c::CanRenderText(std::u32string_view str) const
+{
+	for (size_t idx = 0; idx < str.size();) {
+		int escLen = IsColorEscape(str.substr(idx));
+		if (escLen) {
+			idx += escLen;
+			continue;
+		}
+		if (!CanRenderCodepoint(str[idx])) {
+			return false;
+		}
+		++idx;
+	}
+	return true;
+}
+
+f_runtimeGlyph_s* r_font_c::GetRuntimeGlyph(int height, char32_t cp)
+{
+	if (!runtimeFont || !runtimeFont->ready || !runtimeFont->HasGlyph(cp)) {
+		return nullptr;
+	}
+
+	height = (std::max)(height, 1);
+	auto& glyphByCodepoint = runtimeFont->glyphsByHeight[height];
+	auto& glyph = glyphByCodepoint[cp];
+	if (glyph) {
+		return glyph.get();
+	}
+
+	glyph = std::make_unique<f_runtimeGlyph_s>();
+	if (FT_Set_Pixel_Sizes(runtimeFont->face, 0, static_cast<FT_UInt>(height))) {
+		return glyph.get();
+	}
+	if (FT_Load_Char(runtimeFont->face, static_cast<FT_ULong>(cp), FT_LOAD_RENDER | FT_LOAD_TARGET_NORMAL)) {
+		return glyph.get();
+	}
+
+	auto slot = runtimeFont->face->glyph;
+	auto& bitmap = slot->bitmap;
+	glyph->width = static_cast<int>(bitmap.width);
+	glyph->height = static_cast<int>(bitmap.rows);
+	glyph->bearingX = slot->bitmap_left;
+	glyph->bearingY = slot->bitmap_top;
+	glyph->advance = static_cast<int>((slot->advance.x + 32) >> 6);
+	glyph->valid = true;
+
+	if (bitmap.width > 0 && bitmap.rows > 0 && bitmap.pixel_mode == FT_PIXEL_MODE_GRAY) {
+		std::vector<byte> pixels(bitmap.width * bitmap.rows);
+		int pitch = bitmap.pitch;
+		for (unsigned int row = 0; row < bitmap.rows; ++row) {
+			auto* dst = pixels.data() + row * bitmap.width;
+			auto* src = pitch >= 0
+				? bitmap.buffer + row * pitch
+				: bitmap.buffer + (bitmap.rows - 1 - row) * -pitch;
+			memcpy(dst, src, bitmap.width);
+		}
+		auto raw = std::make_unique<image_c>();
+		if (raw->CopyRaw(IMGTYPE_GRAY, bitmap.width, bitmap.rows, pixels.data())) {
+			glyph->tex = new r_tex_c(renderer->texMan, std::move(raw), TF_NOMIPMAP | TF_CLAMP);
+		}
+	}
+
+	return glyph.get();
+}
