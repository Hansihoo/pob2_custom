+		}
+		auto path = fontPath.generic_u8string();
+		if (FT_New_Face(library, path.c_str(), 0, &face)) {
+			renderer->sys->con->Warning("failed to load runtime font '%s'", path.c_str());
+			FT_Done_FreeType(library);
+			library = nullptr;
+			return;
+		}
+		ready = true;
+	}
+
+	~f_runtimeFont_s()
+	{
+		for (auto& sizeEntry : glyphsByHeight) {
+			for (auto& glyphEntry : sizeEntry.second) {
+				delete glyphEntry.second->tex;
+			}
+		}
+		if (face) {
+			FT_Done_Face(face);
+		}
+		if (library) {
+			FT_Done_FreeType(library);
+		}
+	}
+
+	bool HasGlyph(char32_t cp) const
+	{
+		return ready && FT_Get_Char_Index(face, static_cast<FT_ULong>(cp)) != 0;
+	}
+};
