@@ -2160,6 +2162,46 @@ static int l_SetForeground(lua_State* L)
 	return 0;
 }
 
+SG_LUA_CPP_FUN_BEGIN(GetRuntimeFeature)
+{
+	ui_main_c* ui = GetUIPtr(L);
+	ui_luaReader_c reader(ui, L, "GetRuntimeFeature");
+	ui->LExpect(L, lua_gettop(L) >= 1, "Usage: GetRuntimeFeature(featureName)");
+	auto feature = reader.ArgToString(1);
+
+	bool supported = false;
+	if (feature == "bitmapText" || feature == "asciiText") {
+		supported = true;
+	}
+	else if (feature == "unicodeText" || feature == "cjkText" || feature == "ttfText") {
+		supported = false;
+	}
+
+	lua_pushboolean(L, supported);
+	return 1;
+}
+SG_LUA_CPP_FUN_END()
+
+SG_LUA_CPP_FUN_BEGIN(CanRenderText)
+{
+	ui_main_c* ui = GetUIPtr(L);
+	ui_luaReader_c reader(ui, L, "CanRenderText");
+	ui->LExpect(L, lua_gettop(L) >= 1, "Usage: CanRenderText(text)");
+	auto text = reader.ArgToString(1);
+
+	bool supported = true;
+	for (unsigned char ch : text) {
+		if (ch >= 0x80) {
+			supported = false;
+			break;
+		}
+	}
+
+	lua_pushboolean(L, supported);
+	return 1;
+}
+SG_LUA_CPP_FUN_END()
